{
  "openapi": "3.0.0",
  "info": {
    "title": "Stripe API (Demo Snapshot v2 - Breaking)",
    "version": "2026-06-01"
  },
  "paths": {
    "/v1/charges": {
      "post": {
        "summary": "Create a charge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "integer" },
                  "currency": { "type": "string" },
                  "payment_method": { "type": "string", "description": "Replaces deprecated source parameter" }
                },
                "required": ["amount", "currency"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful charge",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "amount": { "type": "integer" },
                    "currency": { "type": "string" },
                    "payment_method": { "type": "string" },
                    "status": { "type": "string" }
                  },
                  "required": ["id", "amount", "status"]
                }
              }
            }
          }
        }
      }
    },
    "/v1/customers": {
      "post": {
        "summary": "Create a customer",
        "responses": {
          "200": {
            "description": "Customer object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "email": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
