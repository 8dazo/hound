{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HoundConfig",
  "type": "object",
  "required": ["version", "watch"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "watch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/WatchTarget"
      }
    },
    "report": {
      "$ref": "#/definitions/ReportConfig"
    },
    "llm": {
      "$ref": "#/definitions/LLMConfig"
    }
  },
  "definitions": {
    "WatchTarget": {
      "type": "object",
      "required": ["name", "spec_url", "scan_paths"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "spec_url": {
          "type": "string"
        },
        "scan_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "language": {
          "type": "string",
          "enum": ["python", "typescript", "javascript"],
          "default": "python"
        },
        "ignore_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ReportConfig": {
      "type": "object",
      "properties": {
        "github_issues": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "repo": { "type": "string" },
            "token": { "type": "string" },
            "labels": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["hound", "dependency-risk"]
            },
            "assignees": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "slack": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "webhook_url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "min_severity": {
          "type": "string",
          "enum": ["breaking", "deprecation", "non_breaking"],
          "default": "breaking"
        }
      },
      "additionalProperties": false
    },
    "LLMConfig": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "azure_openai", "huggingface_local", "none"],
          "default": "none"
        },
        "model": {
          "type": "string",
          "default": "gpt-4o-mini"
        },
        "api_key": {
          "type": "string"
        },
        "api_base": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
